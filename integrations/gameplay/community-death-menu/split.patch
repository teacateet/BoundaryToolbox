+void BrtPrepareDeployment(SDK::UObject* sender)
+{
+    if (!loginCompleted.load() || gameThreadId.load() != GetCurrentThreadId())
+        return;
+    if (!sender || !sender->IsA(UPBItemFieldModWidget_Character::StaticClass()))
+        return;
+    auto* item = static_cast<UPBItemFieldModWidget_Character*>(sender);
+    if (!item->IsVisible()) return;
+    auto* pc = BrtDeathMenu::ObserveNativeSelection(item->GetOwningPlayer());
+    if (!pc || !pc->bShowSelectRole) return;
+    auto* field = static_cast<UPBFieldModManager*>(USubsystemBlueprintLibrary::GetWorldSubsystem(pc, UPBFieldModManager::StaticClass()));
+    if (!field) return;
+    const bool card = sender->IsA(UUMG_CharacterItem_C::StaticClass());
+    if (card && !item->GetIsEnabled()) return;
+    const FName selected = card ? item->ItemId : field->GetSelectCharacterID();
+    const auto available = field->GetCharacterDefinitionIDScopeInTheMatch();
+    for (int i = 0; i < available.Num(); ++i)
+    {
+        if (!(selected == available[i]) || selected == FName{}) continue;
+        if (card)
+        {
+            // 蓝图的点击回调可能只确认悬停项，先选中真正被点击的可用卡片。
+            if (!(field->GetSelectCharacterID() == selected)) item->SelectCharacter();
+        }
+        else
+        {
+            item->ItemId = selected;
+            item->RefreshOnSelectCharacter(selected);
+        }
+        return;
+    }
+}
+
+void BrtRoleConfirmed(SDK::UObject* sender, const SDK::FName& role)
+{
+    if (loginCompleted.load() && gameThreadId.load() == GetCurrentThreadId())
+        BrtDeathMenu::Confirmed(sender, role);
+}
+
+void BrtOptionClicked(SDK::UObject* sender, int option)
+{
+    if (loginCompleted.load() && gameThreadId.load() == GetCurrentThreadId())
+        BrtDeathMenu::OptionClicked(sender, option);
+}
