+namespace {
+struct GunPair {
+    std::uint64_t first{}, second{};
+    bool operator==(const GunPair& other) const { return first == other.first && second == other.second; }
+};
+FName NameOf(std::uint64_t raw) {
+    FName name{};
+    std::memcpy(&name, &raw, sizeof(raw));
+    return name;
+}
+std::uint64_t RawOf(const FName& name) {
+    std::uint64_t raw{};
+    std::memcpy(&raw, &name, sizeof(raw));
+    return raw;
+}
+
+// 只读取该角色在原生预订表中的主副枪；表不可读或没有该角色时返回空。
+std::optional<GunPair> TableGuns(const APBPlayerState* state, std::uint64_t role, std::uintptr_t offset) {
+    using namespace brt::preorder::native;
+    RawTable table;
+    if (!Value(ReadGame, reinterpret_cast<std::uintptr_t>(state) + offset, table) || !Valid(table.roles) ||
+        !Valid(table.inventories) || table.roles.count != table.inventories.count) return {};
+    for (std::int32_t index = 0; index < table.roles.count; ++index) {
+        std::uint64_t key{};
+        RawInventory inventory;
+        if (!Value(ReadGame, table.roles.data + std::uintptr_t(index) * 8, key)) return {};
+        if (key != role) continue;
+        if (!Value(ReadGame, table.inventories.data + std::uintptr_t(index) * sizeof(RawInventory), inventory) ||
+            !Valid(inventory.slots) || !Valid(inventory.items) || inventory.slots.count != inventory.items.count) return {};
+        GunPair guns;
+        for (std::int32_t item = 0; item < inventory.slots.count; ++item) {
+            std::uint8_t slot{};
+            std::uint64_t id{};
+            if (!Value(ReadGame, inventory.slots.data + std::uintptr_t(item), slot) ||
+                !Value(ReadGame, inventory.items.data + std::uintptr_t(item) * 8, id)) return {};
+            if (slot == 1) guns.first = id;
+            else if (slot == 2) guns.second = id;
+        }
+        return guns;
+    }
+    return {};
+}
+
+std::optional<Loadout> ReadPlan(const std::string& reply, const Selection& chosen) {
+    const Json document = Json::parse(reply.begin(), reply.end(), nullptr, false);
+    if (!document.is_object()) return {};
+    try {
+        const auto& data = document.at("loadout");
+        Loadout plan{chosen.role, ReadName(data.at("LeftLauncherData"), "ID"), ReadName(data.at("RightLauncherData"), "ID"),
+            ReadName(data.at("MobilityModuleData"), "MobilityModuleID"), ReadName(data.at("MeleeWeaponData"), "ID"),
+            ReadWeapon(data.at("FirstWeaponPartData"), chosen.primary), ReadWeapon(data.at("SecondWeaponPartData"), chosen.secondary), {}};
+        if (data.contains("CharacterData")) {
+            const auto& fields = data.at("CharacterData");
+            CharacterAppearance look;
+            if (fields.contains("SpacesuitID")) look.suit = ReadName(fields, "SpacesuitID");
+            if (fields.contains("SpacesuitSkinPaintingID")) look.painting = ReadName(fields, "SpacesuitSkinPaintingID");
+            if (fields.contains("ArmBadgeID")) look.badge = ReadName(fields, "ArmBadgeID");
+            if (fields.contains("HeadAccessoryID")) look.head = ReadName(fields, "HeadAccessoryID");
+            if (look.suit && *look.suit == None) return {};
+            plan.character = std::move(look);
+        }
+        return plan;
+    } catch (const std::exception&) { return {}; }
+}
