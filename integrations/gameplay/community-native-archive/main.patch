+// 专服进程自己的档案写入记录；物品 ID 是游戏内名称，不含账号。
+void ArchiveLog(const char* format, ...) noexcept {
+    try {
+        static unsigned lines{};
+        if (lines >= 400) return;
+        ++lines;
+        char text[420]{};
+        va_list arguments;
+        va_start(arguments, format);
+        std::vsnprintf(text, sizeof(text), format, arguments);
+        va_end(arguments);
+        std::printf("[BRT-ARCHIVE] %s\n", text);
+        std::fflush(stdout);
+        static std::ofstream file = [] {
+            std::error_code error;
+            std::filesystem::create_directory("logs", error);
+            return std::ofstream("logs/BRT-archive-" + std::to_string(GetCurrentProcessId()) + ".log", std::ios::app);
+        }();
+        if (file.is_open()) { file << "[BRT-ARCHIVE] " << text << '\n'; file.flush(); }
+    } catch (...) {}
+}
