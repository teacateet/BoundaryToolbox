+// 读回与期望的第一处差异，供同场日志定位。
+std::string FirstDifference(const FPBWeaponNetworkConfig& actual, const FPBWeaponNetworkConfig& desired) {
+    if (actual.WeaponID != desired.WeaponID) return "weapon-id";
+    if (actual.WeaponClassID != desired.WeaponClassID) return "class-id";
+    if (actual.OrnamentID != desired.OrnamentID) return "ornament";
+    if (actual.WeaponPartConfigs.Num() != actual.WeaponPartSlotTypeArray.Num()) return "actual-arrays";
+    for (int j = 0; j < desired.WeaponPartSlotTypeArray.Num() && j < desired.WeaponPartConfigs.Num(); ++j) {
+        const auto slot = static_cast<int>(desired.WeaponPartSlotTypeArray[j]);
+        int i = 0;
+        while (i < actual.WeaponPartSlotTypeArray.Num() && actual.WeaponPartSlotTypeArray[i] != desired.WeaponPartSlotTypeArray[j]) ++i;
+        if (i >= actual.WeaponPartConfigs.Num()) return "slot-missing-" + std::to_string(slot);
+        const auto& a = actual.WeaponPartConfigs[i];
+        const auto& b = desired.WeaponPartConfigs[j];
+        if (a.WeaponPartID != b.WeaponPartID) return "part-" + std::to_string(slot);
+        if (a.WeaponPartSkinID != b.WeaponPartSkinID) return "skin-" + std::to_string(slot);
+        if (a.WeaponPartSkinPaintingID != b.WeaponPartSkinPaintingID) return "paint-" + std::to_string(slot);
+        if (a.WeaponPartSpecialSkinID != b.WeaponPartSpecialSkinID) return "special-" + std::to_string(slot);
+    }
+    return actual.WeaponPartConfigs.Num() != desired.WeaponPartConfigs.Num() ? "count" : "none";
+}
