+                        caps[0] = caps[1];
+                        mode->BotBackfillType = EPBBotBackfillType::FillWholeTeam;
+                        mode->bCanBotsJoinTeamContainsPlayers = true;
+                        mode->EnableBackfillPlayerIfBotsAlreadyInGame(true);
