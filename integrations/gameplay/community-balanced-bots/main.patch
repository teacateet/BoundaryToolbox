+                auto* authority = CurrentWorld->AuthorityGameMode;
+                if (Config.IsPvE && brt::bots::Enabled() && authority->IsA(APBGameMode::StaticClass())) {
+                    auto* mode = static_cast<APBGameMode*>(authority);
