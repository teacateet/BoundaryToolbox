+// ======================================================
+//  BuildCharacterLoadout — 同一角色只发一次装备
+// ======================================================
+
+// 原生在角色被占有时按配装生成武器、挂载、机动和近战，且不清理旧件。回合倒计时会
+// 对开赛时已出生的同一角色再占有一次，首命因此带着两套装备，后一套的机动装备没有归属。
+void BrtBuildLoadout(APBCharacter *Character, void *Loadout)
+{
+    if (Character && (Character->Inventory.Num() > 0 || Character->CurrentMobilityModule ||
+                      Character->CurrentLeftLauncher || Character->CurrentRightLauncher ||
+                      Character->CurrentMeleeWeapon))
+        return;
+    BrtBuildLoadoutHook.call<void>(Character, Loadout);
+}
