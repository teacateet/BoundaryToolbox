+    nativeWeaponId(roleId, id) {
+        const { index, role } = this.getRoleDefinition(roleId);
+        if (!role || !id) return null;
+        if (role.weaponScope.has(id) && index.getItemType(id) === "EPBItemType::Weapon") return id;
+        if (!index.getWeapon(id)) return null;
+        const choices = (index.baseToRoleWeapon.get(id) || []).filter(item => role.weaponScope.has(item));
+        return choices.length === 1 ? choices[0] : null;
+    }
+
+    nativePodId(roleId, id) {
+        const { index, role } = this.getRoleDefinition(roleId);
+        if (!role || !id) return null;
+        if (role.podScope.has(id)) return id;
+        if (index.getItemType(id) !== "EPBItemType::Pod") return null;
+        const matches = (index.baseToRoleWeapon.get(id) || []).filter(key => role.podScope.has(key));
+        return matches.length === 1 ? matches[0] : null;
+    }
+
+    commitNativeEdit(playerId, roleId, change) {
+        const { role: definition } = this.getRoleDefinition(roleId);
+        if (!playerId || !definition) return false;
+        try {
+            // 校验和落盘都成功后才替换缓存；拒绝的更新不能污染后续读取。
+            const roles = structuredClone(this.load(playerId)?.roles || {});
+            if (!change(this.getRoleForNativeUpdate(roles, roleId), definition)) return false;
+            this.save(playerId, { playerId, roles });
+            return true;
+        } catch (error) {
+            console.warn("[ARCHIVE] Native edit not saved:", error.message);
+            return false;
+        }
+    }
+
+    updateNativeEquipment(roleId, target, definition, op, item, skinBytes) {
+        if (op === 7) {
+            if (!skinBytes?.length || item) return false;
+            const type = protobuf.loadSync(SKIN_PROTO).lookupType("ProjectBoundary.SkinPayload");
+            const edit = type.decode(skinBytes);
+            const hasModel = Object.hasOwn(edit, "TokenId");
+            const hasPaint = Object.hasOwn(edit, "OrnamentId");
+            if (!hasModel && !hasPaint) return false;
+            const previous = this.getNativeRoleSkinConfig(roleId, target).Suit;
+            const token = hasModel ? edit.TokenId : previous.SkinItem;
+            const paint = hasPaint ? edit.OrnamentId : (token === previous.SkinItem ? previous.PaintItem : "");
+            // 发行协议的旧款示例和历史互操作测试使用这对 ID，现行定义不再列出它们。
+            const legacySuit = roleId.toUpperCase() === "PEACE" && "PEACE_TOK-DOS-01" === token;
+            if (!token || (!definition.spaceSuitSkinScope.has(token) && !legacySuit)) return false;
+            const normalized = legacySuit ? ((paint === "" || paint === "None" || paint === token + "_PTOriginal") ? paint : null) :
+                require("../role-paint-scope.cjs").canonicalCharacterPaint(token, paint);
+            if (normalized === null) return false;
+            target._skinToken = token;
+            target._ornamentId = normalized;
+            const bytes = hasModel && hasPaint && normalized === paint ? skinBytes : type.encode({ TokenId: token, OrnamentId: normalized }).finish();
+            target._skinData = Buffer.from(bytes).toString("hex");
+            return true;
+        }
+        if (skinBytes?.length) return false;
+        const slots = {
+            1: ["primaryWeapon", "weaponScope"], 2: ["secondaryWeapon", "weaponScope"],
+            3: ["meleeWeapon", "meleeWeaponScope"], 4: ["mobilityModule", "mobilityScope"],
+            5: ["leftPylon", "podScope"], 6: ["rightPylon", "podScope"],
+            9: ["_armBadgeId", "armBadgeScope"], 10: ["_headAccessoryId", "headAccessoryScope"],
+        };
+        const slot = slots[op];
+        if (!slot) return false;
+        const id = !item || item === "None" ? "None" :
+            (op === 1 || op === 2 ? this.nativeWeaponId(roleId, item) :
+                op === 5 || op === 6 ? this.nativePodId(roleId, item) : item);
+        if (!id || (id !== "None" && !definition[slot[1]].has(id))) return false;
+        if ((op === 1 || op === 2) && id !== "None") {
+            const base = getDefinitionIndex().resolveBaseWeaponId(id);
+            const archives = target._weaponArchives || {};
+            if (!archives[id] && !archives[base]) {
+                const raw = this.getWeaponArchiveRawForRole(target, id, roleId);
+                if (raw) target._weaponArchives = { ...archives, [id]: raw };
+            }
+        }
+        target[slot[0]] = id;
+        return true;
+    }
