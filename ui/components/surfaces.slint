import { ScrollView } from "std-widgets.slint";
import { Txt } from "foundation.slint";

// 主页面面板和弹窗主体使用的深色圆角容器。
export component Panel inherits Rectangle {
    in property <brush> fill: #151922;
    in property <brush> stroke: #273041;
    in property <length> radius: 18px;

    background: fill;
    border-color: stroke;
    border-width: 1px;
    border-radius: radius;
    clip: true;

    @children
}

// 页面和面板头部使用的统一标题/副标题块。
export component TitleBlock inherits Rectangle {
    in property <string> title;
    in property <string> sub: "";

    height: sub == "" ? 32px : 52px;
    background: #00000000;

    VerticalLayout {
        alignment: start;
        spacing: 3px;

        Txt {
            text: title;
            color: #eef4fb;
            font-size: 22px;
            font-weight: 700;
        }

        if sub != "" : Txt {
            text: sub;
            color: #95a3b8;
            font-size: 12px;
            font-weight: 500;
        }
    }
}

// 顶部栏展示的紧凑状态标签。
export component StatusTag inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <brush> accent: #62e2c1;

    height: 42px;
    min-width: 144px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #273041;
    background: #0f131a;
    opacity: 1.0;

    animate opacity { duration: 420ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 9px;

        Rectangle {
            width: 5px;
            background: #00000000;

            Rectangle {
                width: parent.width;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: accent;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;
            horizontal-stretch: 1;

            Txt {
                text: title;
                color: #eef4fb;
                font-size: 13px;
                font-weight: 700;
            }

            Txt {
                text: sub;
                color: #95a3b8;
                font-size: 11px;
                font-weight: 500;
            }
        }
    }
}

// 用于路径、状态和诊断信息的标签+值容器。
export component InfoBox inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <brush> accent: #62e2c1;
    in property <length> box-height: 88px;

    height: box-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: #273041;
    background: #0f131a;
    clip: true;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 4px;
            background: accent;
        }

        VerticalLayout {
            alignment: start;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 11px;
            padding-bottom: 11px;
            spacing: 6px;

            Txt {
                text: label;
                color: accent;
                font-size: 11px;
                font-weight: 700;
            }

            Txt {
                text: value;
                color: #eef4fb;
                font-size: 14px;
                font-weight: 500;
                wrap: char-wrap;
            }
        }
    }
}

// 安装过程的线性进度和当前步骤明细。
export component ProgressBox inherits Rectangle {
    in property <bool> shown: false;
    in property <float> progress: 0.0;
    in property <string> percent: "0%";
    in property <string> title: "";
    in property <string> detail: "";
    in property <int> detail-lines: 1;
    property <length> detail-natural-height: detail-lines <= 1 ? 18px : detail-lines * 18px;
    property <length> detail-visible-height: min(detail-natural-height, 88px);

    height: shown ? 78px + detail-visible-height : 0px;
    border-radius: 14px;
    border-width: shown ? 1px : 0px;
    border-color: #273041;
    background: shown ? #0f131a : #00000000;
    clip: true;

    if shown : VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 9px;

        HorizontalLayout {
            height: 20px;
            spacing: 12px;

            Txt {
                text: title;
                color: #eef4fb;
                font-size: 13px;
                font-weight: 800;
                horizontal-stretch: 1;
                wrap: no-wrap;
            }

            Txt {
                width: 54px;
                text: percent;
                color: #62e2c1;
                font-size: 12px;
                font-weight: 800;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: no-wrap;
            }
        }

        Rectangle {
            height: 12px;
            border-radius: 6px;
            background: #1a2432;
            clip: true;

            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * progress;
                border-radius: 6px;
                background: #62e2c1;

                animate width { duration: 160ms; easing: ease-out; }
            }
        }

        ScrollView {
            height: root.detail-visible-height;
            viewport-width: self.width;
            viewport-height: root.detail-natural-height;

            Txt {
                width: parent.width;
                height: root.detail-natural-height;
                text: detail;
                color: #aebbd0;
                font-size: 12px;
                font-weight: 600;
                wrap: char-wrap;
            }
        }
    }
}

// 带强调条的设置/状态行。
export component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <brush> accent: #62e2c1;
    in property <length> row-height: 76px;

    height: row-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: #273041;
    background: #0f131a;
    clip: true;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;

        Rectangle {
            width: 6px;
            background: #00000000;

            Rectangle {
                width: parent.width;
                height: 40px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: accent;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;

            Txt {
                text: label;
                color: accent;
                font-size: 11px;
                font-weight: 800;
                horizontal-stretch: 1;
            }

            Txt {
                text: value;
                color: #eef4fb;
                font-size: 13px;
                font-weight: 500;
                wrap: char-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}
