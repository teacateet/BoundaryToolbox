import { ComboBox } from "std-widgets.slint";
import { Caption, Command, Value } from "workbench.slint";
import { Txt } from "foundation.slint";
import { I18n } from "../i18n.slint";

export component TutorialOverlay inherits Rectangle {
    in property <int> step: 1;
    in property <int> language-mode;
    in property <bool> has-target;
    in property <bool> is-admin;
    in property <string> feedback-group;
    in property <bool> feedback-copied;
    callback language-changed(int);
    callback copy-feedback();
    callback target_clicked(int);
    callback next_clicked();
    callback skip_clicked();
    callback finish_clicked();

    background: #080d10bc;
    TouchArea {}
    private property <[string]> notes: [
        I18n.tr("选择界面语言。安装遇到问题可联系反馈群。", "Choose your language. Contact the QQ group for installation help.", "表示言語を選択してください。導入の相談は QQ グループへ。"),
        I18n.tr("确认 Steam 游戏目录，点「安装社区环境」。依赖已随完整 ZIP 提供，可以离线安装。", "Select your Steam game folder and install the included components. No download is needed.", "Steam のゲームフォルダーを選び、同梱の環境を導入します。オフラインで導入できます。"),
        I18n.tr("启用本机人机匹配后，进入原版大厅选择难度。地图自动轮换。", "Enable local PvE matchmaking, then choose the difficulty in the game lobby. Maps rotate automatically.", "ローカル PvE マッチを有効にして、ロビーで難易度を選択します。マップは自動で切り替わります。"),
        I18n.tr("点「创建好友房」，默认合作人机。建好后点「复制好友邀请」，发给朋友，然后点「进入房间」。", "Create a friend room for co-op, copy the invite, send it to a friend, then enter.", "「フレンドルームを作成」で協力プレイを開始。招待をコピーして送り、ルームに入ります。"),
        I18n.tr("朋友复制邀请，在「房间」点「粘贴并加入」。游玩时保持工具箱打开。", "Friends copy the invite and click Paste and join in Rooms. Keep the toolbox open while playing.", "フレンドは招待をコピーし、「ルーム」で「貼り付けて参加」を押します。プレイ中はツールを開いたままにしてください。")
    ];
    private property <[string]> actions: [
        I18n.tr("开始设置", "Get started", "設定を始める"),
        I18n.tr("安装社区环境", "Install components", "環境を導入"),
        I18n.tr("下一步", "Next", "次へ"),
        I18n.tr("联机 · 房间", "Multiplayer · Rooms", "マルチ · ルーム"),
        I18n.tr("完成", "Finish", "完了")
    ];
    panel := Rectangle {
        width: min(504px, parent.width - 32px);
        height: form.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 4px; border-width: 1px; border-color: #63716c; background: #192121;
        form := VerticalLayout {
            padding: 16px; spacing: 12px;
            HorizontalLayout {
                Txt { text: I18n.tr("安装向导", "Setup guide", "導入ガイド"); color: #f5eee4; font-size: 20px; font-weight: 700; horizontal-stretch: 1; }
                Caption { text: root.step + " / 5"; }
            }
            Value { text: root.notes[root.step - 1]; min-height: 40px; }
            if root.step == 1 : HorizontalLayout {
                Caption { text: I18n.tr("界面语言", "Language", "表示言語"); horizontal-stretch: 1; }
                ComboBox { width: 150px; model: ["Auto", "中文", "English", "日本語"];
                    current-index: root.language-mode + 1;
                    selected(_) => { root.language-changed(self.current-index - 1); }
                }
            }
            if root.step == 1 : HorizontalLayout {
                Value { text: I18n.tr("反馈 QQ 群", "Feedback QQ group", "サポート QQ") + "  " + root.feedback-group; }
                Command { label: root.feedback-copied ? I18n.tr("已复制", "Copied", "コピー済み") : I18n.tr("复制群号", "Copy number", "番号をコピー"); clicked => { root.copy-feedback(); } }
            }
            HorizontalLayout { spacing: 8px;
                Command { label: I18n.tr("退出向导", "Exit guide", "ガイドを閉じる"); clicked => { root.skip_clicked(); } }
                Rectangle { horizontal-stretch: 1; }
                if root.step == 2 : Command { label: I18n.tr("稍后安装", "Install later", "後で導入"); clicked => { root.next_clicked(); } }
                Command { label: root.actions[root.step - 1]; emphasis: true;
                    enabled: root.step != 2 || (root.has-target && root.is-admin);
                    clicked => {
                        if root.step == 5 { root.finish_clicked(); }
                        else if root.step == 3 { root.next_clicked(); }
                        else { root.target_clicked(root.step); }
                    }
                }
            }
        }
    }
}
