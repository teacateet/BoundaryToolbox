import { ServerRow } from "../models.slint";
import { Workbench, Divider, Caption, Value, Command, Field } from "../components/workbench.slint";
import { ServerLine } from "../rows/server_rows.slint";
import { I18n } from "../i18n.slint";
import { OnlineTabs } from "../header.slint";

export component ServersPage inherits Workbench {
    in property <bool> servers_loading;
    in property <bool> busy;
    in property <string> server_status_text;
    in property <[ServerRow]> server_rows;
    in-out property <string> fixed_room_port;
    in-out property <bool> fixed_room_pve;
    callback switch-page(int);
    in property <string> fixed_room_status;
    in property <bool> fixed_room_running;
    in property <bool> fixed_room_error;
    in property <bool> fixed_room_can_cancel;
    in property <bool> vnt_ready;
    in property <bool> friend_room_working;
    in property <bool> friend_room_connected;
    in property <string> friend_room_notice;
    private property <bool> more;
    callback share_friend_room_clicked();
    callback disconnect_friend_room_clicked();
    in-out property <string> friend_input;
    callback start_fixed_room_clicked();
    callback stop_fixed_room_clicked();
    callback refresh_servers_clicked();
    callback copy_server_address_clicked(address: string);
    callback join_clicked(address: string);
    callback join_clipboard_clicked();
    callback copy_room_invite_clicked(vnt: bool);
    callback join_own_room_clicked();

    public pure function mode-button-center(pve: bool) -> Point {
        return pve ? { x: pve-button.absolute-position.x + pve-button.width / 2,
                       y: pve-button.absolute-position.y + pve-button.height / 2 }
                   : { x: pvp-button.absolute-position.x + pvp-button.width / 2,
                       y: pvp-button.absolute-position.y + pvp-button.height / 2 };
    }
    public pure function room-action-center(start: bool) -> Point {
        return start ? { x: start-button.absolute-position.x + start-button.width / 2, y: start-button.absolute-position.y + start-button.height / 2 }
                     : { x: stop-button.absolute-position.x + stop-button.width / 2, y: stop-button.absolute-position.y + stop-button.height / 2 };
    }

    OnlineTabs { busy: root.busy; switch-page(page) => { root.switch-page(page); } }
    Caption { text: I18n.tr("朋友开好了房？", "Have an invite?", "招待を受け取ったら"); }
    HorizontalLayout { spacing: 8px;
        endpoint := Field { text <=> root.friend_input; placeholder: I18n.tr("复制朋友的邀请，点右边加入", "Copy your friend’s invite, then click Join", "招待をコピーして右の参加ボタンを押す"); enabled: !root.busy && !root.friend_room_working;
            accepted => { if self.enabled && self.text != "" { root.join_clicked(self.text); } }
        }
        Command { label: endpoint.text == "" ? I18n.tr("粘贴并加入", "Paste and join", "貼り付けて参加") : I18n.tr("加入对局", "Join match", "対戦に参加"); emphasis: true;
            enabled: !root.busy && !root.friend_room_working; clicked => { if endpoint.text == "" { root.join_clipboard_clicked(); } else { root.join_clicked(endpoint.text); } } }
    }
    Divider {}
    HorizontalLayout { min-height: 26px; spacing: 12px;
        Caption { text: I18n.tr("自己开房", "Host a room", "自分で開く"); }
        pve-button := Command { label: I18n.tr("合作人机", "Co-op", "協力 PvE"); emphasis: root.fixed_room_pve; enabled: !root.busy && !root.fixed_room_running && !root.friend_room_working; clicked => { root.fixed_room_pve = true; } }
        pvp-button := Command { label: I18n.tr("玩家对战", "Versus", "対戦 PvP"); emphasis: !root.fixed_room_pve; enabled: !root.busy && !root.fixed_room_running && !root.friend_room_working; clicked => { root.fixed_room_pve = false; } }
        Value { text: root.fixed_room_status; color: root.fixed_room_error ? #ffaaa0 : root.fixed_room_running ? #88e1b7 : #acb8b3; horizontal-alignment: right; }
    }
    HorizontalLayout { spacing: 8px;
        alignment: start;
        start-button := Command { label: root.fixed_room_error && !root.fixed_room_running ? I18n.tr("重新建房", "Retry room", "再試行") : I18n.tr("创建好友房", "Create friend room", "フレンドルームを作成"); emphasis: !root.fixed_room_running; enabled: !root.busy && !root.fixed_room_running && !root.friend_room_connected; clicked => { root.start_fixed_room_clicked(); } }
        stop-button := Command { label: root.fixed_room_can_cancel ? I18n.tr("取消建房", "Cancel start", "起動をキャンセル") : root.fixed_room_error && !root.fixed_room_running ? I18n.tr("返回", "Back", "戻る") : I18n.tr("停止房间", "Stop room", "ルームを停止"); enabled: root.fixed_room_can_cancel || (!root.busy && (root.fixed_room_running || root.fixed_room_error)); clicked => { root.stop_fixed_room_clicked(); } }
        Command { label: I18n.tr("高级选项", "More", "詳細"); enabled: !root.busy; clicked => { root.more = !root.more; } }
    }
    if root.fixed_room_running : HorizontalLayout { spacing: 8px; alignment: start;
        Command { label: I18n.tr("复制好友邀请", "Copy friend invite", "フレンド招待をコピー"); emphasis: true; enabled: !root.busy && !root.friend_room_working;
            clicked => { root.share_friend_room_clicked(); } }
        Command { label: I18n.tr("进入房间", "Enter room", "ルームに入る"); enabled: !root.busy && !root.friend_room_working; clicked => { root.join_own_room_clicked(); } }
        Command { label: I18n.tr("同一 Wi-Fi 邀请", "LAN invite", "同じ LAN の招待"); enabled: !root.busy && !root.friend_room_working; clicked => { root.copy_room_invite_clicked(false); } }
    }
    if root.more : HorizontalLayout { spacing: 8px;
        Caption { text: I18n.tr("游戏端口", "Game port", "ポート"); }
        Field { text <=> root.fixed_room_port; input-type: InputType.number; enabled: !root.busy && !root.fixed_room_running; }
        if root.fixed_room_running && root.vnt_ready : Command { label: I18n.tr("复制已有组网邀请", "Copy custom network invite", "詳細ネットワークの招待"); enabled: !root.busy; clicked => { root.copy_room_invite_clicked(true); } }
    }
    if root.friend_room_notice != "" || root.friend_room_connected : HorizontalLayout { spacing: 8px;
        Value { text: root.friend_room_notice; }
        if root.friend_room_connected: Command { label: root.friend_room_working ? I18n.tr("取消连接", "Cancel", "キャンセル") : I18n.tr("断开好友连接", "Disconnect", "切断"); enabled: !root.busy; clicked => { root.disconnect_friend_room_clicked(); } }
    }
    Value { text: I18n.tr("房主创建房间，把邀请发给朋友，然后进入房间。朋友复制邀请，点「粘贴并加入」。对局期间双方保持工具箱开着。", "Create a room, send the invite, then enter. Friends copy it and click Paste and join. Keep both toolboxes open during play.", "ホストはルームを作成し、招待を送って入室。フレンドは招待をコピーして「貼り付けて参加」を押します。対戦中はツールを開いたままにしてください。"); }
    Divider {}
    HorizontalLayout { height: 36px; spacing: 12px;
        Caption { text: I18n.tr("社区服务器", "Community servers", "コミュニティサーバー"); horizontal-stretch: 1; }
        Command { label: root.servers_loading ? I18n.tr("刷新中", "Refreshing", "更新中") : I18n.tr("刷新列表", "Refresh list", "一覧を更新");
            enabled: !root.servers_loading; clicked => { root.refresh_servers_clicked(); } }
    }
    Value { text: root.server_status_text; }
    for server in root.server_rows: ServerLine {
        name: server.name; address: server.address; meta: server.meta; state: server.state; players: server.players;
        active: server.active; joinable: server.joinable && !root.busy;
        join_clicked(address) => { root.join_clicked(address); }
        copy_clicked(address) => { root.copy_server_address_clicked(address); }
    }
}
